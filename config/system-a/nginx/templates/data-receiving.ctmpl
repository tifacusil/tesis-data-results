# Generated by consul-template — do not edit manually.
# ServicePort in Consul = health port (808x); TCP data port = ServicePort - 3081.
upstream data_receiving {
    least_conn;
{{- range service "data-receiving|passing" }}
    server {{ .Address }}:{{ subtract 3081 .Port }} max_fails=3 fail_timeout=10s;
{{- else }}
    server 127.0.0.1:5000 max_fails=3 fail_timeout=10s;
{{- end }}
}

server {
    listen 5100;
    proxy_pass data_receiving;
    proxy_timeout 30s;
    proxy_connect_timeout 5s;
}
