# /etc/consul-template/consul-template.hcl — System A
#
# RECONSTRUCTED, not copied: the live file is root:root 0600 and could not be
# read without sudo. Based on the readable backup on the server
# (consul-template.hcl.bak-20260627-231905, which has only the first
# `template` block) plus the second block, inferred because
# stream.d/data-receiving.conf says "Generated by consul-template" and matches
# templates/data-receiving.ctmpl.
# Check against the live file with: sudo cat /etc/consul-template/consul-template.hcl

consul {
  address = "127.0.0.1:8500"

  # Consul runs with ACL default_policy = "deny" (/etc/consul.d/consul.hcl).
  # Without a token that can read the catalog, `service "..."` returns nothing
  # and every upstream falls back to its static server. NOT VERIFIED: whether
  # the live file sets the token here or relies on the anonymous token's policy.
  token = "<CONSUL_TOKEN_CONSUL_TEMPLATE>"

  retry {
    enabled     = true
    attempts    = 0          # retry forever
    backoff     = "250ms"
    max_backoff = "10s"
  }
}

# HTTP gateway (:80)
template {
  source      = "/etc/consul-template/templates/nginx.conf.ctmpl"
  destination = "/etc/nginx/sites-enabled/default"
  perms       = 0644
  command     = "/bin/sh -c 'nginx -t && nginx -s reload'"

  wait {
    min = "2s"
    max = "10s"
  }

  error_on_missing_key = false
}

# TCP ingestion (:5100)
template {
  source      = "/etc/consul-template/templates/data-receiving.ctmpl"
  destination = "/etc/nginx/stream.d/data-receiving.conf"
  perms       = 0644
  command     = "/bin/sh -c 'nginx -t && nginx -s reload'"

  wait {
    min = "2s"
    max = "10s"
  }

  error_on_missing_key = false
}
