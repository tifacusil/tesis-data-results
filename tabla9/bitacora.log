import csv, json
for s, f in (('A','A-ladder-0917-timeseries.csv'), ('B','B-ladder-0923-timeseries.csv')):
    rows = list(csv.DictReader(open('/c/Users/adria/Escritorio/TESIS/tesis-data-results/data/'+f)))
    for k, col, nd in (('cpu','node_cpu_pct',2), ('mem','node_mem_used_mib',1)):
        v = json.load(open(f'prometheus/{s}_ladder_{k}.json'))['data']['result'][0]['values']
        assert len(v) == len(rows) == 181, (s, k, len(v), len(rows))
        bad = sum(abs(round(float(x), nd) - float(r[col])) > 10**-nd/2 for (t, x), r in zip(v, rows))
        print(s, col, len(v), 'rows, mismatches:', bad); assert bad == 0
"
